@model IEnumerable<DataAccess.Models.KhademAttendance>
@using DataAccess.Models
@{ ViewData["Title"] = "پروفایل من"; var leaves = (IEnumerable<LeaveRequest>)ViewBag.Leaves; }
<div class="d-flex justify-content-between align-items-center my-4"><h3>پروفایل من</h3><a asp-action="CreateLeave" class="btn btn-warning">ثبت درخواست مرخصی</a></div>
<ul class="nav nav-tabs mb-3"><li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#attendance">ورود و خروج من</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#leaves">درخواست‌های مرخصی</button></li></ul>
<div class="tab-content"><div class="tab-pane fade show active" id="attendance"><div class="table-responsive"><table class="table table-striped"><thead><tr><th>تاریخ</th><th>ورود</th><th>خروج</th><th>توضیحات</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.AttendanceDate.ToString("yyyy/MM/dd")</td><td>@item.EntryTime?.ToString("HH:mm")</td><td>@item.ExitTime?.ToString("HH:mm")</td><td>@item.Notes</td></tr>}</tbody></table></div></div><div class="tab-pane fade" id="leaves"><div class="table-responsive"><table class="table table-striped"><thead><tr><th>تاریخ</th><th>توضیحات</th><th>وضعیت</th><th>پیام مدیریت</th></tr></thead><tbody>@foreach(var item in leaves){var finalized=item.Status is LeaveRequestStatuses.Approved or LeaveRequestStatuses.Rejected;<tr><td>@item.LeaveDate.ToString("yyyy/MM/dd")</td><td>@item.Description</td><td>@item.Status</td><td>@(finalized ? item.ManagementComment : "پس از اعلام سرشیفت نمایش داده می‌شود")</td></tr>}</tbody></table></div></div></div>
