@model IEnumerable<DataAccess.Models.Khadem>

@{
    ViewData["Title"] = "Index";
    var shiftLeads = (IEnumerable<DataAccess.Models.Khadem>)ViewBag.ShiftLeads;
    var assignableKhadems = (IEnumerable<DataAccess.Models.Khadem>)ViewBag.AssignableKhadems;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-secondary">مدیریت خادمین</h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill shadow-sm">ثبت خادم جدید</a>
    </div>

    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#khadem-list" type="button">فهرست خادمان</button></li>
        @if (User.IsInRole("مدیریت"))
        {
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#shift-lead-assignment" type="button">تخصیص سرشیفت</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#shift-leads" type="button">مدیریت سرشیفت‌ها</button></li>
        }
    </ul>

    <div class="tab-content">
    <div class="tab-pane fade show active" id="khadem-list">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <!-- استفاده از رنگ‌های پاستیلی بر اساس تخصص یا رندوم -->
                <div class="card shadow-sm border-0 h-100 card-pastel-primary">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h5 class="card-title fw-bold">@item.FullName</h5>
                            <span class="badge bg-white text-primary rounded-pill">شیفت @item.Shift</span>
                        </div>
                        <hr />
                        <p class="mb-1"><strong>کد پرسنلی:</strong> @item.PersonalCode</p>
                        <p class="mb-1"><strong>تخصص:</strong> @item.Specialization</p>
                        <p class="mb-1"><strong>روز کاری:</strong> @item.WorkingDay</p>
                        <p class="mb-1"><strong>شماره تماس:</strong> @item.PhoneNumber</p>
                        <p class="mb-1"><strong>نقش:</strong> @item.Role</p>
                        @if (item.Role == "خادم")
                        {
                            <p class="mb-1"><strong>سرشیفت:</strong> @(item.ShiftLead?.FullName ?? "تخصیص داده نشده")</p>
                        }
                        
                        <div class="mt-3 d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary w-50">ویرایش</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light text-danger w-50">حذف</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    </div>

    @if (User.IsInRole("مدیریت"))
    {
        <div class="tab-pane fade" id="shift-lead-assignment">
            @if (TempData["AssignmentError"] is string error) { <div class="alert alert-danger">@error</div> }
            @if (TempData["AssignmentSuccess"] is string success) { <div class="alert alert-success">@success</div> }
            @if (!shiftLeads.Any())
            {
                <div class="alert alert-warning">ابتدا حداقل یک کاربر را با نقش «سرشیفت» ثبت یا ویرایش کنید.</div>
            }
            else
            {
                <p class="text-muted">برای هر خادم، سرشیفت مسئول او را انتخاب کنید.</p>
                <div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>خادم</th><th>شیفت کاری</th><th>سرشیفت فعلی</th><th>عملیات</th></tr></thead><tbody>
                @foreach (var servant in Model.Where(item => item.Role == "خادم"))
                {
                    <tr><td>@servant.FullName</td><td>@servant.Shift</td><td>@(servant.ShiftLead?.FullName ?? "—")</td><td>
                        <form asp-action="AssignShiftLead" method="post" class="d-flex gap-2">
                            <input type="hidden" name="khademId" value="@servant.Id" />
                            <select name="shiftLeadId" class="form-select form-select-sm">
                                <option value="">بدون سرشیفت</option>
                                @foreach (var lead in shiftLeads)
                                {
                                    if (servant.ShiftLeadId == lead.Id)
                                    {
                                        <option value="@lead.Id" selected>@lead.FullName</option>
                                    }
                                    else
                                    {
                                        <option value="@lead.Id">@lead.FullName</option>
                                    }
                                }
                            </select>
                            <button class="btn btn-sm btn-primary">ذخیره</button>
                        </form>
                    </td></tr>
                }
                </tbody></table></div>
            }
        </div>

        <div class="tab-pane fade" id="shift-leads">
            @if (TempData["ShiftLeadSuccess"] is string scheduleSuccess) { <div class="alert alert-success">@scheduleSuccess</div> }
            <div class="card border-0 bg-light mb-4"><div class="card-body">
                <h5>تعیین سرشیفت جدید</h5>
                @if (!assignableKhadems.Any())
                {
                    <p class="mb-0 text-muted">خادمی برای انتخاب باقی نمانده است.</p>
                }
                else
                {
                    <form asp-action="MakeShiftLead" method="post" class="row g-2 align-items-end">
                        <div class="col-md-5"><label class="form-label">خادم</label><select name="khademId" class="form-select" required><option value="">انتخاب خادم...</option>@foreach (var khadem in assignableKhadems) { <option value="@khadem.Id">@khadem.FullName</option> }</select></div>
                        <div class="col-md-3"><label class="form-label">روز هفته</label><select name="workingDay" class="form-select" required><option>شنبه</option><option>یکشنبه</option><option>دوشنبه</option><option>سه‌شنبه</option><option>چهارشنبه</option><option>پنجشنبه</option><option>جمعه</option></select></div>
                        <div class="col-md-2"><label class="form-label">شیفت</label><select name="shift" class="form-select"><option value="1">صبح</option><option value="2">عصر</option><option value="3">شب</option></select></div>
                        <div class="col-md-2"><button class="btn btn-success w-100">تعیین سرشیفت</button></div>
                    </form>
                }
            </div></div>

            @if (!shiftLeads.Any())
            {
                <div class="alert alert-info">هنوز سرشیفت ثبت نشده است.</div>
            }
            else
            {
                <div class="accordion" id="shiftLeadsAccordion">
                @foreach (var lead in shiftLeads)
                {
                    var leadServants = Model.Where(item => item.ShiftLeadId == lead.Id).ToList();
                    var collapseId = $"lead-{lead.Id}";
                    <div class="accordion-item"><h2 class="accordion-header" id="heading-@lead.Id"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId">@lead.FullName <span class="badge bg-primary me-2">@leadServants.Count خادم</span></button></h2>
                    <div id="@collapseId" class="accordion-collapse collapse" data-bs-parent="#shiftLeadsAccordion"><div class="accordion-body">
                        <form asp-action="UpdateShiftLeadSchedule" method="post" class="row g-2 align-items-end mb-3"><input type="hidden" name="khademId" value="@lead.Id" />
                            <div class="col-md-4"><label class="form-label">روز هفته</label><select name="workingDay" class="form-select">@foreach (var day in new[] { "شنبه", "یکشنبه", "دوشنبه", "سه‌شنبه", "چهارشنبه", "پنجشنبه", "جمعه" }) { if (lead.WorkingDay == day) { <option selected>@day</option> } else { <option>@day</option> } }</select></div>
                            <div class="col-md-3"><label class="form-label">شیفت</label><select name="shift" class="form-select">@for (var i = 1; i <= 3; i++) { if (lead.Shift == i) { <option value="@i" selected>@(i == 1 ? "صبح" : i == 2 ? "عصر" : "شب")</option> } else { <option value="@i">@(i == 1 ? "صبح" : i == 2 ? "عصر" : "شب")</option> } }</select></div>
                            <div class="col-md-2"><button class="btn btn-outline-primary">ذخیره برنامه</button></div>
                        </form>
                        @if (assignableKhadems.Any())
                        {
                            <div class="border-top pt-3 mt-3">
                                <h6>تغییر سرشیفت</h6>
                                <p class="small text-muted">خادمان زیرمجموعهٔ سرشیفت فعلی به شخص جدید منتقل نمی‌شوند و باید جداگانه تخصیص داده شوند.</p>
                                <form asp-action="ReplaceShiftLead" method="post" class="row g-2 align-items-end"><input type="hidden" name="currentShiftLeadId" value="@lead.Id" />
                                    <div class="col-md-4"><label class="form-label">سرشیفت جدید</label><select name="newShiftLeadId" class="form-select" required><option value="">انتخاب خادم...</option>@foreach (var khadem in assignableKhadems) { <option value="@khadem.Id">@khadem.FullName</option> }</select></div>
                                    <div class="col-md-3"><label class="form-label">روز هفته</label><select name="workingDay" class="form-select">@foreach (var day in new[] { "شنبه", "یکشنبه", "دوشنبه", "سه‌شنبه", "چهارشنبه", "پنجشنبه", "جمعه" }) { if (lead.WorkingDay == day) { <option selected>@day</option> } else { <option>@day</option> } }</select></div>
                                    <div class="col-md-2"><label class="form-label">شیفت</label><select name="shift" class="form-select">@for (var i = 1; i <= 3; i++) { if (lead.Shift == i) { <option value="@i" selected>@(i == 1 ? "صبح" : i == 2 ? "عصر" : "شب")</option> } else { <option value="@i">@(i == 1 ? "صبح" : i == 2 ? "عصر" : "شب")</option> } }</select></div>
                                    <div class="col-md-3"><button class="btn btn-warning w-100">تغییر سرشیفت</button></div>
                                </form>
                            </div>
                        }
                        <h6>خادمان زیرمجموعه</h6>
                        @if (leadServants.Any()) { <ul class="mb-0">@foreach (var servant in leadServants) { <li>@servant.FullName <span class="text-muted">— شیفت @servant.Shift</span></li> }</ul> } else { <span class="text-muted">هنوز خادمی به این سرشیفت تخصیص نیافته است.</span> }
                    </div></div></div>
                }
                </div>
            }
        </div>
    }
    </div>
</div>

<style>
    /* همان استایل پاستیلی که قبلاً ساختیم */
    .card-pastel-primary {
        background-color: #d0ebff !important;
        color: #004085 !important;
        border-radius: 15px;
    }
</style>
