@model IEnumerable<DataAccess.Models.LeaveRequest>
@{ ViewData["Title"] = "کارتابل مدیریت"; }
<h3 class="my-4">کارتابل تأیید مرخصی مدیریت</h3><div class="table-responsive"><table class="table table-striped"><thead><tr><th>خادم</th><th>سرشیفت</th><th>تاریخ</th><th>درخواست</th><th>نظر سرشیفت</th><th>تصمیم</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Khadem.FullName</td><td>@item.ShiftLead?.FullName</td><td>@item.LeaveDate.ToString("yyyy/MM/dd")</td><td>@item.Description</td><td>@item.ShiftLeadComment</td><td><form asp-action="Decide" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@item.Id"/><input name="comment" class="form-control form-control-sm" placeholder="توضیح"/><button name="approved" value="true" class="btn btn-sm btn-success">تأیید</button><button name="approved" value="false" class="btn btn-sm btn-danger">رد</button></form></td></tr>}</tbody></table></div>
