@model IEnumerable<DataAccess.Models.LeaveRequest>
@using DataAccess.Models
@{ ViewData["Title"] = "کارتابل مرخصی"; }
<h3 class="my-4">کارتابل مرخصی سرشیفت</h3><div class="table-responsive"><table class="table table-striped"><thead><tr><th>خادم</th><th>تاریخ مرخصی</th><th>توضیحات</th><th>وضعیت</th><th>اقدام</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Khadem.FullName</td><td>@item.LeaveDate.ToString("yyyy/MM/dd")</td><td>@item.Description</td><td>@item.Status</td><td>@if(item.Status==LeaveRequestStatuses.PendingShiftLead){<form asp-action="Forward" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@item.Id"/><input name="comment" class="form-control form-control-sm" placeholder="توضیح برای مدیریت"/><button class="btn btn-sm btn-primary">ارسال به مدیریت</button></form>}else if(item.Status is LeaveRequestStatuses.ApprovedAwaitingShiftLeadNotification or LeaveRequestStatuses.RejectedAwaitingShiftLeadNotification){<div class="small mb-2"><strong>پیام مدیریت:</strong> @item.ManagementComment</div><form asp-action="AnnounceToKhadem" method="post"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-sm btn-success">اعلام به خادم</button></form>}</td></tr>}</tbody></table></div>
