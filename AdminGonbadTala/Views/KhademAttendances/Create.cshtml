@model DataAccess.Models.KhademAttendance
@using DataAccess.Models
@{ ViewData["Title"] = "ثبت ورود و خروج"; var servants=(IEnumerable<Khadem>)ViewBag.Servants; }
<div class="card shadow-sm border-0 my-4"><div class="card-body p-4"><h4>ثبت ورود و خروج خادم</h4><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="KhademId" class="form-label">خادم</label><select asp-for="KhademId" class="form-select"><option value="">انتخاب خادم...</option>@foreach(var servant in servants){<option value="@servant.Id">@servant.FullName</option>}</select></div><div class="col-md-6"><label asp-for="AttendanceDate" class="form-label"></label><input asp-for="AttendanceDate" type="date" class="form-control" /></div><div class="col-md-6"><label asp-for="EntryTime" class="form-label"></label><input asp-for="EntryTime" type="time" class="form-control" /></div><div class="col-md-6"><label asp-for="ExitTime" class="form-label"></label><input asp-for="ExitTime" type="time" class="form-control" /></div><div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3" placeholder="موارد خاص، تأخیر، توضیحات..."></textarea></div></div><button class="btn btn-primary mt-4">ثبت</button><a asp-action="Index" class="btn btn-outline-secondary mt-4">بازگشت</a></form></div></div>
